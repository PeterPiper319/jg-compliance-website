---
// src/components/HeroSection.astro
---

<section class="relative bg-white pt-16 md:pt-24 pb-20 overflow-hidden">
  <div class="container mx-auto px-4 text-center relative z-10">
    
    <div class="mb-6">
      <span class="text-xs font-bold text-brand-grey uppercase tracking-wider">TENDERMATCH  |  ARCHITECTED FOR EXCELLENCE</span>
    </div>

    <h1 class="text-4xl md:text-6xl font-extrabold text-brand-blue tracking-tight mb-6 leading-tight">
      Helping South African Contractors <br class="hidden md:block" />
      Stay Compliant & Win Tenders
    </h1>

    <p class="text-xl text-brand-grey max-w-2xl mx-auto mb-10 leading-relaxed">
      Take the stress out of company admin. We track and manage your CIPC, Annual Returns, and Labour compliance so you never miss a multi-million rand business opportunity.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/contact" class="w-full sm:w-auto px-8 py-4 bg-brand-blue text-white rounded-lg font-bold hover:bg-brand-blue/90 transition-all shadow-lg shadow-brand-blue/20">
        Get Your Free CIPC Status Health Check
      </a>
      <a href="/services" class="w-full sm:w-auto px-8 py-4 bg-white text-brand-blue border border-gray-200 rounded-lg font-bold hover:border-brand-blue/30 hover:bg-gray-50 transition-all">
        View Services
      </a>
    </div>
  </div>

  <div class="absolute inset-0 z-0 opacity-[0.03]" 
       style="background-image: radial-gradient(#002B5B 1px, transparent 1px); background-size: 32px 32px;">
  </div>
</section>