---
// src/pages/services/popia/paia-manual.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import { PRICING_2026 } from '../../../config/brand';

const pageTitle = "PAIA Manual Drafting & Compliance";
---

<BaseLayout title={pageTitle}>
  <ServiceHero 
    title={pageTitle}
    subtitle="Legally mandatory documentation describing your records and access protocols."
    price={PRICING_2026.paiaManual}
    turnaround="3-5 Business Days"
  />

  <main class="container mx-auto px-4 py-16">
    <div class="max-w-3xl mx-auto">
      <div class="bg-amber-50 border-l-4 border-amber-500 p-6 mb-10">
        <h3 class="text-lg font-bold text-amber-700 mb-2">2026 Compliance Deadline</h3>
        <p class="text-amber-800">
          Under the Promotion of Access to Information Act, every business (Private Body) is required to compile and maintain a PAIA Manual. Failure to produce this manual upon request can lead to administrative fines.
        </p>
      </div>
      
      <div class="text-center">
        <a href="/contact?service=paia" class="bg-brand-blue text-white px-8 py-4 rounded-lg font-bold">
          Request PAIA Manual Drafting
        </a>
      </div>
    </div>
  </main>
</BaseLayout>