---
// src/pages/services/cipc/annual-returns.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import { PRICING_2026 } from '../../../config/brand';
import { ROUTE_SEO, SITE_METADATA } from '../../../config/seo';

const { title: pageTitle, description: pageDescription } = ROUTE_SEO.annualReturns;

const currentMonth = new Date().toLocaleString('default', { month: 'long' });

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "CIPC Annual Returns Filing",
  "provider": {
    "@type": "ProfessionalService",
    "name": SITE_METADATA.legalName
  },
  "description": pageDescription,
  "serviceType": "Corporate Maintenance",
  "offers": {
    "@type": "Offer",
    "price": PRICING_2026.annualReturnSmall,
    "priceCurrency": "ZAR",
    "priceValidUntil": "2026-12-31"
  }
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <ServiceHero 
    title={pageTitle}
    subtitle="Includes technical verification of the Section 216 Compliance Checklist. Keep your company 'Active' and legally sound."
    price={PRICING_2026.annualReturnSmall} 
    turnaround="1-2 Days"
  />

  <main class="container mx-auto px-4 py-16">
    <div class="max-w-3xl mx-auto">
      
      <div class="bg-red-900 text-white p-6 rounded-xl shadow-xl border-l-8 border-red-500 mb-10 relative overflow-hidden">
        <div class="relative z-10">
          <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
            <span>🛑</span> LEGAL ADVISORY: SECTION 216 COMPLIANCE
          </h3>
          <p class="text-white/90 leading-relaxed font-medium text-sm md:text-base">
            Per Section 216(b) of the Companies Act, providing false or misleading information on CIPC filings is a criminal offense. 
            Conviction can lead to personal fines or imprisonment for up to 12 months. Our 'Architected for Excellence' methodology provides 
            the professional oversight needed to ensure your submissions are legally sound.
          </p>
        </div>
        <div class="absolute inset-0 opacity-10" style="background-image: repeating-linear-gradient(45deg, #000 0, #000 10px, transparent 10px, transparent 20px);"></div>
      </div>

      <div class="bg-amber-50 border-2 border-amber-200 p-8 rounded-xl mb-12 shadow-sm">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-amber-600 text-white rounded-full flex items-center justify-center font-bold">!</div>
          <h2 class="text-xl font-bold text-amber-700 uppercase tracking-tight">Mandatory CIPC Hard-Stop</h2>
        </div>
        <p class="text-amber-800 leading-relaxed font-medium mb-6">
          The CIPC filing system is now hard-linked to the Beneficial Ownership register. 
          <strong>You cannot submit your {currentMonth} Annual Return if your BO filings are incomplete.</strong>
        </p>
        <a href="/services/cipc/beneficial-ownership" class="inline-block bg-amber-600 text-white px-6 py-2 rounded-lg font-bold hover:bg-amber-700 transition-all">
          Resolve BO Status First →
        </a>
      </div>

      <div class="bg-brand-bg p-8 rounded-xl border border-brand-accent/20 text-center">
        <h3 class="text-xl font-bold text-brand-blue mb-2">File Before Deregistration</h3>
        <p class="mb-6 text-sm">We handle the turnover calculation, Section 216 verification, and CIPC submission.</p>
        <a href="/contact?service=annual-returns" class="inline-block bg-brand-blue text-white px-8 py-3 rounded-lg font-semibold hover:bg-brand-blue/90 transition-colors">
          File Annual Return (R{PRICING_2026.annualReturnSmall})
        </a>
      </div>

    </div>
  </main>
</BaseLayout>
