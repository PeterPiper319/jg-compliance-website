---
// src/pages/services/cipc/restoration.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import { PRICING_2026, COMPLIANCE_CONSTANTS } from '../../../config/brand';
import { ROUTE_SEO, SITE_METADATA } from '../../../config/seo';

const { title: pageTitle, description: pageDescription } = ROUTE_SEO.restoration;

// Strategic Logic: High-Complexity Recovery Signal
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Company Restoration (The \"Resurrection\" Pack)",
  "provider": {
    "@type": "ProfessionalService",
    "name": SITE_METADATA.legalName
  },
  "description": "Full legal reinstatement from \"Deregistered\" status. This does not include the CIPC costs or advertisement costs.",
  "serviceType": "Legal Compliance",
  "offers": {
    "@type": "Offer",
    "price": PRICING_2026.restoration,
    "priceCurrency": "ZAR"
  }
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <ServiceHero 
    title={"Company Restoration (The \"Resurrection\" Pack)"}
    subtitle={"Full legal reinstatement from \"Deregistered\" status. This does not include the CIPC costs or advertisement costs."}
    price={PRICING_2026.restoration}
    turnaround="3-6 Months"
  />

  <main class="container mx-auto px-4 py-16">
    <div class="max-w-3xl mx-auto">
      
      <div class="bg-red-50 border-l-4 border-red-500 p-6 mb-10">
        <h3 class="text-lg font-bold text-red-700 mb-2">Critical Requirement: Proof of Activity</h3>
        <p class="text-red-600 leading-relaxed">
          CIPC requires proof that the company was in business at the time of deregistration. 
          You must provide <span class="font-bold">{COMPLIANCE_CONSTANTS.restorationProof}</span> (12 months of bank statements).
          Without this, the restoration application will be rejected.
        </p>
      </div>

      <h3 class="text-2xl font-bold text-brand-blue mb-6">Cost Structure Breakdown</h3>
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div class="bg-white p-6 rounded-lg shadow-sm border border-brand-accent/20">
          <h4 class="font-bold text-brand-blue mb-2">Professional Fee (R{PRICING_2026.restoration.toFixed(2)})</h4>
          <p class="text-xs text-brand-grey mb-4">Covers our intellectual time and administration:</p>
          <ul class="list-disc list-inside text-sm text-brand-grey space-y-2">
            <li>Drafting of CoR 40.5 Application</li>
            <li>Affidavit Commissioning</li>
            <li>Department of Treasury Liaison</li>
            <li>State Attorney Correspondence</li>
            <li>CIPC Case Management</li>
          </ul>
        </div>
        
        <div class="bg-gray-100 p-6 rounded-lg border border-gray-200">
          <h4 class="font-bold text-gray-700 mb-2">Variable Disbursements (Excluded)</h4>
          <p class="text-xs text-gray-600 mb-4">Paid directly to third parties/Govt:</p>
          <ul class="list-disc list-inside text-sm text-gray-600 space-y-2">
            <li>Government Gazette Advertisement</li>
            <li>Local Newspaper Advertisement</li>
            <li>Outstanding CIPC Penalties</li>
            <li>Outstanding Annual Return Fees</li>
          </ul>
        </div>
      </div>

      <div class="bg-brand-bg p-8 rounded-xl border border-brand-accent/20 text-center">
        <h3 class="text-2xl font-bold text-brand-blue mb-4">Ready to Restore?</h3>
        <p class="text-brand-grey mb-8 max-w-2xl mx-auto">
          This is a complex legal process. Our specialists will guide you through every step, ensuring all advertisements and filings are compliant.
        </p>
        <a href="/contact?service=restoration" class="inline-block bg-brand-blue text-white px-8 py-4 rounded-lg font-bold hover:bg-brand-blue/90 transition-colors shadow-lg shadow-brand-blue/20">
          Start Restoration Process
        </a>
      </div>
    </div>
  </main>
</BaseLayout>