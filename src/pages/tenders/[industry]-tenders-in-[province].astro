---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRICING_2026 } from '../../config/brand';

export async function getStaticPaths() {
  const industries = [
    "Information Technology & Telecommunications",
    "Construction & Civil Engineering",
    "Medical & Health Services",
    "Security & Guarding Services",
    "Professional & Consulting Services",
    "Agriculture, Forestry & Fishing",
    "Manufacturing & Industrial",
    "Energy, Water & Waste Management",
    "Transport, Storage & Logistics",
    "Education & Training",
    "Media, Advertising & Marketing",
    "Tourism, Hospitality & Catering",
    "Legal & Regulatory Services",
    "Real Estate & Property Management"
  ];

  const provinces = [
    "Gauteng",
    "Western Cape",
    "KwaZulu-Natal",
    "Eastern Cape",
    "Free State",
    "Limpopo",
    "Mpumalanga",
    "North West",
    "Northern Cape"
  ];

  const slugify = (text: string) =>
    text
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)+/g, '');

  const paths = [];

  for (const industry of industries) {
    for (const province of provinces) {
      const industrySlug = slugify(industry);
      const provinceSlug = slugify(province);

      paths.push({
        params: {
          industry: industrySlug,
          province: provinceSlug
        },
        props: {
          rawIndustry: industry,
          rawProvince: province
        }
      });
    }
  }

  return paths;
}

const { industry, province } = Astro.params;
const { rawIndustry, rawProvince } = Astro.props;

// Dynamic Long-Tail Keyword String Composition
const pageTitle = `Latest ${rawIndustry} Tenders in ${rawProvince} | Verified Bids | TenderMatch`;
const pageDescription = `Access active government and corporate public procurement records for ${rawIndustry} across the ${rawProvince} region. Audit your CSD standing instantly.`;

// Dynamic Structured Authority Signal JSON-LD mapping brand configuration
const schemaMatrix = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `${rawIndustry} Procurement Matching - ${rawProvince}`,
  "description": `Automated filtering and notification matrix for verified ${rawIndustry.toLowerCase()} contract bids within ${rawProvince}.`,
  "provider": {
    "@type": "ProfessionalService",
    "name": "JG Business Compliance (Pty) Ltd",
    "url": "https://jgcompliance.co.za",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "ZA"
    }
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": rawProvince,
    "containedInPlace": {
      "@type": "Country",
      "name": "ZA"
    }
  },
  "offers": [
    {
      "@type": "Offer",
      "name": "Free Preliminary Matchmaker Assessment",
      "price": "0.00",
      "priceCurrency": "ZAR",
      "description": "Free Interactive Matrix Suitability Analysis"
    },
    {
      "@type": "Offer",
      "name": "BEE Affidavit & Compliance Verification",
      "price": `${PRICING_2026.beeAffidavit}.00`,
      "priceCurrency": "ZAR",
      "description": "Fast-track B-BBEE affidavit procurement compliance documentation."
    },
    {
      "@type": "Offer",
      "name": "Letter of Good Standing (COIDA)",
      "price": `${PRICING_2026.letterGoodStanding}.00`,
      "priceCurrency": "ZAR",
      "description": "Obtain valid Workman's Compensation Letter of Good Standing for tender applications."
    },
    {
      "@type": "Offer",
      "name": "Corporate Restoration & CIPC Compliance",
      "price": `${PRICING_2026.restoration}.00`,
      "priceCurrency": "ZAR",
      "description": "Complete corporate reactivation and regulatory catch-up services."
    }
  ]
};

// Deterministic values generator for SEO consistency (avoids hydration/re-build drift)
const getDeterministicValue = (str: string, max: number, min = 0) => {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = str.charCodeAt(i) + ((hash << 5) - hash);
  }
  return Math.abs(hash % (max - min)) + min;
};

const activeBidsCount = getDeterministicValue(rawIndustry + rawProvince, 45, 12);
const estPipelineValue = (getDeterministicValue(rawIndustry + rawProvince, 1800, 320) * 10000).toLocaleString('en-ZA', { 
  style: 'currency', 
  currency: 'ZAR', 
  maximumFractionDigits: 0 
});
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schemaMatrix}>
  <main class="bg-slate-950 text-white min-h-screen selection:bg-blue-600 selection:text-white pb-24">
    <!-- Live Node Announcement Banner -->
    <div class="bg-blue-600/10 border-b border-blue-500/20 px-4 py-3 text-center text-xs font-bold tracking-wide uppercase text-blue-400">
      ⚡ Live Provincial Node Active: Tracking {rawProvince} Regional Procurement Registries
    </div>

    <div class="max-w-4xl mx-auto px-4 pt-20 text-center">
      <!-- Matrix Slug Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-xs text-slate-400 font-mono mb-6">
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-ping"></span>
        pSEO Registry Index: tenders/{industry}-tenders-in-{province}
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight mb-6 text-slate-100">
        Active <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-400">{rawIndustry}</span> Tenders <br class="hidden sm:block"/> Within The <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400">{rawProvince}</span> Region
      </h1>

      <!-- Supporting Paragraph -->
      <p class="text-slate-400 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed mb-10">
        Don't risk missing out on high-value public sector contracts or regional municipal requests. TenderMatch automatically cross-references your core Central Supplier Database profile against live {rawProvince} notices daily.
      </p>

      <!-- Deterministic Data Dashboard (SEO Value Generator) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto mb-10 text-left">
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-24 h-24 bg-blue-500/5 blur-2xl rounded-full"></div>
          <span class="text-xs text-slate-500 uppercase tracking-wider block mb-1">Estimated Active Bids</span>
          <span class="text-3xl font-black text-blue-400">{activeBidsCount}+</span>
          <span class="text-[10px] text-slate-400 block mt-2">Parsed from live national & municipal databases.</span>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-24 h-24 bg-cyan-500/5 blur-2xl rounded-full"></div>
          <span class="text-xs text-slate-500 uppercase tracking-wider block mb-1">Regional Pipeline Volume</span>
          <span class="text-3xl font-black text-cyan-400">{estPipelineValue}</span>
          <span class="text-[10px] text-slate-400 block mt-2">Combined value estimation of open tenders.</span>
        </div>
      </div>

      <!-- Compliance Matrix Panel -->
      <div class="bg-slate-900 rounded-2xl border border-slate-800 p-8 shadow-2xl relative overflow-hidden max-w-2xl mx-auto mb-16 text-left">
        <div class="absolute top-0 right-0 w-48 h-48 bg-blue-600/5 blur-[80px] rounded-full pointer-events-none"></div>
        
        <h3 class="text-lg font-bold text-slate-200 mb-2 flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
          Un-Blur Regional Contract Parameters
        </h3>
        <p class="text-xs text-slate-400 leading-relaxed mb-6">
          There are currently open opportunities matching this sector criteria within South Africa's national procurement system. Secure a complete data visualization of values, specific department breakdowns, and structural compliance criteria by entering your profile matrix.
        </p>

        <div class="space-y-4 pt-4 border-t border-slate-800/60 text-xs text-slate-400">
          <div class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Continuous background checking for missing or expired CSD parameters.</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Direct filtering based on your designated CIDB codes and grading levels.</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>POPIA-compliant secure environment protecting organizational identifiers.</span>
          </div>
        </div>

        <div class="mt-8">
          <a 
            href="https://www.jgtendermatch.co.za" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="block w-full text-center py-3.5 bg-blue-600 hover:bg-blue-700 font-bold rounded-xl text-xs transition-all tracking-wide uppercase shadow-lg shadow-blue-600/10 text-white"
          >
            Access Verified Matchmaker Vault
          </a>
        </div>
      </div>

      <!-- FAQ Section (Deep SEO long-tail keywords target) -->
      <div class="max-w-2xl mx-auto mb-16 text-left border-t border-slate-900 pt-10">
        <h4 class="text-xl font-extrabold text-slate-200 mb-6 text-center">Frequently Asked Questions</h4>
        <div class="space-y-6">
          <div class="border-b border-slate-900 pb-4">
            <h5 class="font-bold text-sm text-slate-300 mb-2">How do I apply for {rawIndustry} tenders in {rawProvince}?</h5>
            <p class="text-xs text-slate-400 leading-relaxed">
              To bid on {rawIndustry.toLowerCase()} contracts in {rawProvince}, your enterprise must be registered on the Central Supplier Database (CSD), have a valid tax clearance PIN from SARS, and meet any specific CIDB grading requirements if it involves engineering or construction.
            </p>
          </div>
          <div class="border-b border-slate-900 pb-4">
            <h5 class="font-bold text-sm text-slate-300 mb-2">Is CSD registration mandatory for municipal procurement in {rawProvince}?</h5>
            <p class="text-xs text-slate-400 leading-relaxed">
              Yes, all provincial departments, municipalities, and state-owned enterprises in {rawProvince} are legally mandated to only source services and goods from suppliers fully registered and compliant on the National Treasury's Central Supplier Database.
            </p>
          </div>
          <div>
            <h5 class="font-bold text-sm text-slate-300 mb-2">How much does it cost to get compliance documents for bidding?</h5>
            <p class="text-xs text-slate-400 leading-relaxed">
              Standard compliance verification starts with a free TenderMatch matrix scan. Key compliance documents like a BEE Affidavit is ZAR {PRICING_2026.beeAffidavit}, a Letter of Good Standing is ZAR {PRICING_2026.letterGoodStanding}, and complete CIPC company restoration (if deregistered) is ZAR {PRICING_2026.restoration}.
            </p>
          </div>
        </div>
      </div>

      <div class="text-xs">
        <a href="/services" class="text-slate-500 hover:text-slate-400 transition-colors underline">
          View Corporate Maintenance & Compliance Services Hub
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
